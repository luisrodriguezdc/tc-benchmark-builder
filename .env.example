# Copy to .env and fill in values from the Supabase project settings.
# Streamlit Community Cloud should use the equivalent keys in Secrets.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres URL (Settings → Database). Used by local scripts and tests.
# Prefer the session pooler or direct URI, not the service-role API key.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# First-admin bootstrap
ADMIN_EMAIL=you@example.com
ADMIN_DISPLAY_NAME=Admin
